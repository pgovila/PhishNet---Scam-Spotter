# PhishNet — Environment Variables
# Copy this file to .env and fill in the values you need.
# Only PHISHNET_API_KEYS is needed for the API. Everything else is optional.

# ── Scoring Mode ──────────────────────────────────────────────────────────────
# Set to "1" to use the organisers' rulebook scoring instead of default.
# RULEBOOK_MODE=1

# ── API Authentication ────────────────────────────────────────────────────────
# Comma-separated list of valid API keys for POST /v1/analyze.
# If empty, all requests are allowed (dev mode).
# PHISHNET_API_KEYS=your-key-1,your-key-2

# ── Optional: AI Layer (Anthropic Claude) ─────────────────────────────────────
# The app works fully without these. AI is OFF by default.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Optional: Google Safe Browsing v4 ─────────────────────────────────────────
# Free for non-commercial use. Web Risk API is the commercial equivalent.
# Get a key: https://console.cloud.google.com/apis/credentials
# GSB_API_KEY=AIza...

# ── Optional: VirusTotal API v3 ───────────────────────────────────────────────
# Free tier: 4 lookups/min, 500/day.
# Sign up: https://www.virustotal.com/gui/join-us
# VT_API_KEY=...

# ── Optional: URLhaus by abuse.ch ─────────────────────────────────────────────
# Free Auth-Key required. Check https://urlhaus-api.abuse.ch for current terms.
# URLHAUS_AUTH_KEY=...
